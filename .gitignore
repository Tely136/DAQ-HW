# Sources live here; generated projects/workspaces belong in C:/DAQ-BUILD.
# These rules also cover accidental in-repo builds. Keep HDL/C/C++, tests,
# XDC, Tcl, HLS configs, CMake inputs, linker scripts and IP/BD definitions.

# Local build/workspace directories (reserved names).
/DAQ-BUILD/
/workspaces/
build/
cmake-build-*/
Debug/
Release/

# Vivado generated project products. Do not ignore *.srcs or *.xpr:
# they may contain intentional design/project inputs.
.Xil/
*.cache/
*.gen/
*.runs/
*.sim/
*.hw/
*.ip_user_files/
ip_user_files/
xsim.dir/
webtalk/
*.jou
*.log
*.str
*.pb
*.wdb
*.vcd
*.dcp
*.bit
*.ltx
*.mmi
*.xpr.zip

# Vitis/HLS transient state. Keep vitis-comp.json and hls_config.cfg.
.autopilot/
.apc/
.metadata/
.rigel_lopper/
RemoteSystemsTempFiles/
.vitisWorkspace.json
**/_ide/logs/
**/_ide/.wsdata/
**/_ide/workspace_journal*.py
**/_ide/.peers.ini
**/_ide/.vitisPlatformRepo.json
**/_ide/version.ini
**/_ide/hwspec.checksum
*.hlscompile_summary
*.hlsrun_*_summary
*.adb
*.adb.xml

# Standard HLS work-directory output, scoped beneath the HLS source tree.
/hls/**/hls/syn/
/hls/**/hls/sim/
/hls/**/hls/csim/
/hls/**/hls/impl/
/hls/**/solution*/syn/
/hls/**/solution*/sim/
/hls/**/solution*/csim/
/hls/**/solution*/impl/

# Compilers, CMake, Ninja and language-server caches.
.cache/
.clangd/
compile_commands.json
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
build.ninja
rules.ninja
.ninja_deps
.ninja_log
*.o
*.obj
*.d
*.elf
*.exe
*.a
*.so
*.dll
*.pdb
*.ilk

# Python automation caches and local environments.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Editor/OS temporary files. Shared .vscode settings stay tracked.
.vs/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Intentionally NOT ignored: *.xsa (hardware handoffs), *.bin/*.mem/*.coe
# (possible test/ROM inputs), *.wcfg (wave setups), *.rpt (saved reports),
# *.tcl, *.xci, *.bd, *.json, *.yaml, .clangd files, and source Makefiles.
# Store routine reports/binaries/platforms in the external build directory.
